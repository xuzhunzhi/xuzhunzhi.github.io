<article class="post-single">
  <h1 class="post-title"><%= page.title %></h1>
  <div class="post-meta">
    <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
    <% if (page.categories && page.categories.length) { %> · <% page.categories.each(function(c){ %><a class="meta-tag" href="<%= url_for('/categories/' + encodeURIComponent(c.name)) %>"><%= c.name %></a><% }) %><% } %>
  </div>
  <div class="post-content"><%- page.content %></div>
  <% if (page.tags && page.tags.length) { %>
    <div class="post-tags">
      <% page.tags.each(function(t){ %><a class="meta-tag" href="<%= url_for('/tags/' + encodeURIComponent(t.name)) %>"># <%= t.name %></a><% }) %>
    </div>
  <% } %>
  <nav class="post-nav">
    <% if (page.prev) { %><span>上一篇：<a href="<%= url_for(page.prev.path) %>"><%= page.prev.title %></a></span><% } %>
    <% if (page.next) { %><span>下一篇：<a href="<%= url_for(page.next.path) %>"><%= page.next.title %></a></span><% } %>
  </nav>
</article>
