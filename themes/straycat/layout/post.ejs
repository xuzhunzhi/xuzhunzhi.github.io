<%
  var plain=strip_html(page.content||'').replace(/\s/g,'');var wordCount=plain.length;var readMinutes=Math.max(1,Math.ceil(wordCount/400));var updatedMatch=String(page.raw||'').match(/^updated\s*:\s*(.+)$/mi);var postUpdated=updatedMatch?updatedMatch[1].trim():null;var postCol=page.categories&&page.categories.length?page.categories.first().name:'';var postColMeta=null;(site.data.collections||[]).forEach(function(c){if(c.name===postCol||c.slug===postCol)postColMeta=c;});var sameCollection=[];site.posts.each(function(p){var belongs=false;if(p.categories)p.categories.each(function(c){if(c.name===postCol)belongs=true;});if(belongs)sameCollection.push(p);});sameCollection.sort(function(a,b){return new Date(a.date)-new Date(b.date);});var currentIndex=sameCollection.findIndex(function(p){return p.path===page.path;});var collectionPrev=currentIndex>0?sameCollection[currentIndex-1]:null;var collectionNext=currentIndex>=0&&currentIndex<sameCollection.length-1?sameCollection[currentIndex+1]:null;
%>
<article class="post-single post-reading">
  <aside class="post-toc" aria-label="文章目录"><div class="post-toc-label">目录 / Contents</div><div class="post-toc-list"><%- toc(page.content,{list_number:false}) %></div></aside>
  <div class="post-main">
    <div class="post-kind">ARTICLE / NOTE</div>
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-info-card"><div class="post-info-item"><span>发布时间</span><b><%= date(page.date,'YYYY-MM-DD HH:mm') %></b></div><div class="post-info-item"><span>最后修改</span><b><%= postUpdated?date(postUpdated,'YYYY-MM-DD HH:mm'):'未修改' %></b></div><div class="post-info-item"><span>字数</span><b><%= wordCount.toLocaleString('zh-CN') %></b></div><div class="post-info-item"><span>阅读时间</span><b>约 <%= readMinutes %> 分钟</b></div></div>
    <% if(postCol){ %><div class="post-category-line"><span>合集 / COLLECTION</span><a href="<%= url_for('/categories/'+(postColMeta&&postColMeta.slug?postColMeta.slug:postCol)) %>"><%= postColMeta?postColMeta.name:postCol %></a></div><% } %>
    <button type="button" class="post-toc-button" onclick="openTimelineMenu(document.querySelector('.post-toc'))">▦ <span>文章目录</span></button>
    <div class="post-content"><%- page.content %></div>
    <% if(page.tags&&page.tags.length){ %><div class="post-tags"><% page.tags.each(function(t){ %><a class="meta-tag" href="<%= url_for(t.path) %>"># <%= t.name %></a><% }); %></div><% } %>
    <nav class="post-nav" aria-label="合集文章导航"><% if(collectionPrev){ %><a class="post-nav-card prev" href="<%= url_for(collectionPrev.path) %>"><small>上一篇</small><strong><%= collectionPrev.title %></strong><span>←</span></a><% }else{ %><span class="post-nav-card empty-nav prev"><small>上一篇</small><strong>这是这个合集的第一篇文章</strong></span><% } %><% if(collectionNext){ %><a class="post-nav-card next" href="<%= url_for(collectionNext.path) %>"><small>下一篇</small><strong><%= collectionNext.title %></strong><span>→</span></a><% }else{ %><span class="post-nav-card empty-nav next"><small>下一篇</small><strong>这是这个合集的最后一篇文章</strong></span><% } %></nav>
    <div class="content-actions"><button class="content-action" onclick="togglePostLike(this)"><svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 8.55a5.5 5.5 0 0 0-8.84-1.27 5.5 5.5 0 0 0-8.84 1.27C1.44 12.33 5.5 16 12 20.5c6.5-4.5 10.56-8.17 8.84-11.95Z"/></svg><span>点赞</span></button><button class="content-action" onclick="openPostComment()"><svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H7l-4 3v-6.15A7.5 7.5 0 1 1 20 11.5Z"/><path d="M8 11.5h.01M12 11.5h.01M16 11.5h.01"/></svg><span>评论</span></button><button class="content-action" onclick="openShare('article',-1,location.href,<%= JSON.stringify(page.title) %>,'<%= date(page.date,'YYYY-MM-DD') %>',<%= JSON.stringify(page.description||'') %>,'')"><svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a7 7 0 0 0-12-2"/><path d="M6 6V2m0 4h4"/><path d="M6 16a7 7 0 0 0 12 2"/><path d="M18 18v4m0-4h-4"/></svg><span>转发</span></button></div>
    <section class="comments" aria-label="评论"><div class="comments-label">评论 / Comments</div><script src="https://utteranc.es/client.js" repo="xuzhunzhi/xuzhunzhi.github.io" issue-term="pathname" label="评论" theme="github-dark" crossorigin="anonymous" async></script></section>
  </div>
</article>
<script>
(function(){
  var toc=document.querySelector('.post-toc'),reading=document.querySelector('.post-reading'),main=document.querySelector('.post-main'),content=document.querySelector('.post-content');
  if(!toc||!reading||!main||!content) return;
  function alignToc(){
    if(window.innerWidth<=900){ toc.style.marginTop='0px'; return; }
    var contentRect=content.getBoundingClientRect(),mainRect=main.getBoundingClientRect();
    toc.style.marginTop=Math.max(0,Math.round(contentRect.top-mainRect.top))+'px';
  }
  window.addEventListener('load',alignToc); window.addEventListener('resize',alignToc); alignToc();
  if(document.fonts&&document.fonts.ready) document.fonts.ready.then(alignToc);
})();
</script>
