<section class="hero">
  <h1 class="hero-title">Fragments <em>of Light</em></h1>
  <p class="hero-sub">一些被光留住的碎片，和偶然撞见的瞬间。</p>
</section>

<div class="ptoggle">
  <div class="view-toggle">
    <button class="toggle-btn active" data-view="timeline" onclick="switchView(this,'timeline')">时间线</button>
    <button class="toggle-btn" data-view="album" onclick="switchView(this,'album')">相册</button>
  </div>

  <div class="view-panel" id="view-timeline">
    <% var all = []; (site.data.gallery.albums || []).forEach(function(a){ (a.images || []).forEach(function(im){ all.push({ caption: im.caption, src: im.src, date: String(im.date || '') }); }); }); %>
    <% if (!all.length) { %>
      <p class="empty">还没有图片，等流浪猫慢慢放上来。</p>
    <% } else { %>
      <div class="img-waterfall">
        <% all.sort(function(a,b){ return b.date.localeCompare(a.date); }).forEach(function(im){ %>
          <figure class="img-card" onclick="openLightbox('<%= im.src %>')">
            <img src="<%= im.src %>" alt="<%= im.caption %>" loading="lazy" onerror="this.classList.add('ph')">
            <figcaption class="img-card-caption"><%= im.date %> · <%= im.caption %></figcaption>
          </figure>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="view-panel" id="view-album" style="display:none">
    <% var albums = site.data.gallery.albums || []; %>
    <% if (!albums.length) { %><p class="empty">还没有相册，等流浪猫慢慢放上来。</p><% } %>
    <div class="album-cards">
      <% albums.forEach(function(a, i){ %>
        <div class="album-card" onclick="openAlbum(<%= i %>)">
          <div class="album-card-cover" <%= a.cover ? "style=\"background-image:url('"+a.cover+"')\"" : "" %>><% if (!a.cover) { %><span class="album-card-count"><%= (a.images||[]).length %></span><% } %></div>
          <div class="album-card-body">
            <div class="album-card-name"><%= a.name %></div>
            <% if (a.desc) { %><div class="album-card-desc"><%= a.desc %></div><% } %>
            <div class="album-card-meta"><%= (a.images||[]).length %> 张</div>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="album-modal" id="albumModal" onclick="if(event.target===this)closeAlbum()">
      <div class="album-modal-inner">
        <button class="moment-x" onclick="closeAlbum()" aria-label="关闭">×</button>
        <h2 class="album-modal-name" id="albumModalTitle"></h2>
        <div class="album-grid" id="albumModalGrid"></div>
      </div>
    </div>
  </div>
</div>

<script>
var ALBUMS = <%- JSON.stringify((site.data.gallery.albums||[])).replace(/</g, '\\u003c') %>;
function escHtml(s){ return (s||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]}); }
function openAlbum(i){ var a=ALBUMS[i]; if(!a) return; document.getElementById('albumModalTitle').textContent=a.name; var g=document.getElementById('albumModalGrid'); g.innerHTML=(a.images||[]).map(function(im){ return '<figure class="gallery-item"><img src="'+im.src+'" alt="'+escHtml(im.caption||'')+'" loading="lazy" onerror="this.classList.add(\\\'ph\\\')" onclick="openLightbox(\\\''+im.src+'\\\')"><figcaption>'+escHtml(im.caption||'')+'</figcaption></figure>'; }).join(''); document.getElementById('albumModal').classList.add('show'); lockBody(); }
function closeAlbum(){ document.getElementById('albumModal').classList.remove('show'); unlockBody(); }
function switchView(btn, view){ document.querySelectorAll('.view-toggle .toggle-btn').forEach(function(b){ b.classList.toggle('active', b===btn); }); document.querySelectorAll('.view-panel').forEach(function(p){ p.style.display = (p.id==='view-'+view) ? 'block' : 'none'; }); }
</script>
