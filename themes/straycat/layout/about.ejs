<%
  var siteMeta = site.data.site || {};
  var aboutName = siteMeta.aboutName || '许纯之';
  var aboutPoem = siteMeta.aboutPoem || '一只被抛弃在尘世之中的猫。\n感谢尘世还有那些值得猫眷恋的。\n希望这里成为流浪猫的坟茔。';
  var aboutBio = siteMeta.aboutBio || '你好，我是许纯之，欢迎来到流浪猫为自己搭建的避难所。\n\n这里有很多乱七八糟的东西，包括但不仅限于游戏、数码、日常吐槽。\n\n如果这里的东西能给你一点小小的慰藉，那流浪猫会感到非常荣幸。';
  var aboutProjects = siteMeta.aboutProjects || '03';
  var aboutInspiration = siteMeta.aboutInspiration || '∞';
  var aboutCoffee = siteMeta.aboutCoffee || '42';
  var aboutMoon = siteMeta.aboutMoon || '01';
  var aboutContact = siteMeta.aboutContact || 'xuzhunzhi@foxmail.com';
  var watchedAnime = (site.data.watching || []).filter(function(w){ return w.status === 'finished'; }).length;
%>
<div class="about-hero">
  <div class="about-name"><%= aboutName.slice(0, -1) %><em><%= aboutName.slice(-1) %></em></div>
  <div class="about-aka"><%= siteMeta.aboutAka || 'Xu Zhunzhi / 流浪猫不是LLM / 幼儿班的小超超' %></div>
  <div class="about-poem"><% aboutPoem.split(/\r?\n/).forEach(function(line, i, lines){ %><%= line %><% if(i < lines.length - 1){ %><br><% } %><% }); %></div>
</div>

<div class="about-grid">
  <div class="about-bio">
    <h3>About Me</h3>
    <% aboutBio.split(/\r?\n\s*\r?\n/).filter(function(p){ return p.trim(); }).forEach(function(paragraph){ %>
      <p><%= paragraph.replace(/\r?\n/g, ' ') %></p>
    <% }); %>
    <p style="margin-top:32px;font-style:italic;color:var(--text-m)">"流浪猫不需要和家猫走一样的路。"</p>
  </div>
  <div class="about-side">
    <div class="about-stat"><span class="about-stat-num"><%= aboutProjects %></span><span class="about-stat-label">正在做的项目</span></div>
    <div class="about-stat"><span class="about-stat-num"><%= aboutInspiration %></span><span class="about-stat-label">深夜灵感次数</span></div>
    <div class="about-stat"><span class="about-stat-num"><%= String(watchedAnime).padStart(2, '0') %></span><span class="about-stat-label">看过的番</span></div>
    <div class="about-stat"><span class="about-stat-num"><%= aboutCoffee %></span><span class="about-stat-label">喝掉的咖啡</span></div>
    <div class="about-stat"><span class="about-stat-num"><%= aboutMoon %></span><span class="about-stat-label">窗外的月亮</span></div>
  </div>
</div>

<div class="sec-hd"><span class="sec-num">contact</span><span class="sec-title">联系</span><span class="sec-line"></span></div>
<p class="contact-line"><%= aboutContact %></p>
