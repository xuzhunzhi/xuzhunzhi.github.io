<section class="hero">
  <h1 class="hero-title">深夜 <em>碎碎念</em></h1>
  <p class="hero-sub">没头没尾的念头，深夜记下，就不怕忘了。</p>
</section>

<div class="sec-hd"><span class="sec-num">live</span><span class="sec-title">随笔</span><span class="sec-line"></span></div>

<% var dyn=site.data.dynamics||[],dynMonths={},dynamicCalendarDays={}; dyn.forEach(function(d,i){var raw=String(d.date||''),key=raw.slice(0,7)||'未分类',day=raw.slice(8,10).replace(/^0/,'')||'—';if(typeof dynMonths[key]==='undefined')dynMonths[key]=i;if(/^\d{4}-\d{2}$/.test(key)&&/^\d+$/.test(day)){if(!dynamicCalendarDays[key])dynamicCalendarDays[key]={};if(!dynamicCalendarDays[key][day])dynamicCalendarDays[key][day]={count:0,target:'moment-'+i};dynamicCalendarDays[key][day].count++;}}); function momentImages(d){return d.images&&d.images.length?d.images:(d.image?[d.image]:[]);} %>
<div class="archive-timeline-layout dynamics-timeline-layout">
  <aside class="archive-timeline-index" aria-label="动态时间线目录">
    <button type="button" class="archive-timeline-index-label" onclick="openArchiveTimelineCalendar(DYNAMIC_CALENDAR_DATA)" aria-label="打开动态时间线日历"><span class="timeline-index-glyph" aria-hidden="true">▦</span><span>时间目录</span></button>
    <nav>
      <% Object.keys(dynMonths).sort(function(a,b){return b.localeCompare(a);}).forEach(function(key,index){ var target='moment-'+dynMonths[key]; %><a href="#<%= target %>" data-target="<%= target %>"<% if(/^\d{4}-\d{2}$/.test(key)){ %> data-month="<%= key %>" onclick="event.preventDefault();openArchiveTimelineCalendar(DYNAMIC_CALENDAR_DATA,this.getAttribute('data-month'))"<% } %><% if(index===0){ %> class="active" aria-current="location"<% } %>><%= key==='未分类'?key:key.replace('-', ' 年 ')+' 月' %></a><% }); %>
    </nav>
  </aside>
  <div class="moment-feed">
  <% if(dyn.length){ %>
    <% dyn.forEach(function(d,i){ var ims=momentImages(d); var layout=ims.length<=1?1:(ims.length<=2?2:(ims.length<=3?3:(ims.length<=4?4:(ims.length<=6?6:9)))); var needsMore=String(d.text||'').split(/\r?\n/).length>6||String(d.text||'').length>180; %>
      <article class="moment" id="moment-<%= i %>" onclick="openMoment(<%= i %>)">
        <div class="moment-head"><img class="moment-avatar" src="/images/avatar.jpg" alt=""><span class="moment-author">许纯之_Official</span></div>
        <div class="moment-content moment-preview <%= needsMore?'is-clamped':'' %>"><%= d.text||'' %></div>
        <% if(needsMore){ %><div class="moment-ellipsis">…</div><button class="moment-more" onclick="event.stopPropagation();openMoment(<%= i %>)">展示全文</button><% } %>
        <% if(ims.length){ %><div class="moment-image-grid layout-<%= layout %>"><% ims.slice(0,layout).forEach(function(src){ %><img src="<%= src %>" alt="" loading="lazy"><% }); if(ims.length>layout){ %><span class="moment-image-more">＋<%= ims.length-layout %></span><% } %></div><% } %>
        <div class="moment-foot"><time class="moment-date"><%= d.date||'' %></time><div class="moment-actions"><button class="moment-action like-action" data-like="<%= i %>" onclick="event.stopPropagation();toggleLike(<%= i %>,this)"><svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 8.55a5.5 5.5 0 0 0-8.84-1.27 5.5 5.5 0 0 0-8.84 1.27C1.44 12.33 5.5 16 12 20.5c6.5-4.5 10.56-8.17 8.84-11.95Z"/></svg><span>点赞</span></button><button class="moment-action" onclick="event.stopPropagation();openComment(<%= i %>)"><svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H7l-4 3v-6.15A7.5 7.5 0 1 1 20 11.5Z"/><path d="M8 11.5h.01M12 11.5h.01M16 11.5h.01"/></svg><span>评论</span></button><button class="moment-action" onclick="event.stopPropagation();openShare('dynamic',<%= i %>,location.origin+'<%= url_for('/dynamics/') %>#moment-<%= i %>','动态 · <%= (d.date||'') %>','<%= d.date||'' %>',<%= JSON.stringify(d.text||'') %>,<%= JSON.stringify(ims[0]||'') %>)"><svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a7 7 0 0 0-12-2"/><path d="M6 6V2m0 4h4"/><path d="M6 16a7 7 0 0 0 12 2"/><path d="M18 18v4m0-4h-4"/></svg><span>转发</span></button></div></div>
        <div class="moment-comments" id="moment-comments-<%= i %>" onclick="event.stopPropagation()"><div class="moment-comments-title">评论 / Comments</div></div>
      </article>
    <% }) %>
  <% }else{ %><p class="empty">还没有动态，等流浪猫慢慢写。</p><% } %>
  </div>
</div>

<script>
var DYNAMIC_CALENDAR_DATA={kind:'dynamic',months:<%- JSON.stringify(dynamicCalendarDays).replace(/</g, '\\u003c') %>};
(function(){var root=document.querySelector('.dynamics-timeline-layout');if(!root)return;var sections=Array.prototype.slice.call(root.querySelectorAll('.moment')),links=Array.prototype.slice.call(root.querySelectorAll('.archive-timeline-index a'));if(!sections.length||!links.length)return;function active(id){links.forEach(function(link){var on=link.getAttribute('data-target')===id;link.classList.toggle('active',on);if(on)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');});}function update(){var current=sections[0],marker=Math.min(180,window.innerHeight*.28);sections.forEach(function(section){if(section.getBoundingClientRect().top<=marker)current=section;});active(current.id);}links.forEach(function(link){link.addEventListener('click',function(){active(link.getAttribute('data-target'));});});window.addEventListener('scroll',update,{passive:true});window.addEventListener('resize',update);update();})();
</script>
