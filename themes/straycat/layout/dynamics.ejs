<section class="hero">
  <h1 class="hero-title">深夜 <em>碎碎念</em></h1>
  <p class="hero-sub">没头没尾的念头，深夜记下，就不怕忘了。</p>
</section>

<div class="sec-hd"><span class="sec-num">live</span><span class="sec-title">动态</span><span class="sec-line"></span></div>

<div class="moment-feed">
  <% var dynOrdered = (site.data.dynamics||[]).slice().sort(function(a,b){ return (b.date||'').localeCompare(a.date||''); }); %>
  <% if (dynOrdered.length) { %>
    <% dynOrdered.forEach(function(d, i){ %>
      <article class="moment" onclick="openMoment(<%= i %>)">
        <div class="moment-head"><span class="feed-type" data-type="rant">动态</span><span class="moment-date"><%= d.date || '' %></span></div>
        <div class="moment-content"><%= d.text %></div>
        <% if (d.image) { %><img class="moment-img" src="<%= d.image %>" alt="" loading="lazy"><% } %>
      </article>
    <% }) %>
  <% } else { %>
    <p class="empty">还没有动态，等流浪猫慢慢写。</p>
  <% } %>
</div>

<div class="moment-modal" id="momentModal" onclick="if(event.target===this)closeMoment()">
  <div class="moment-modal-inner">
    <button class="moment-x" onclick="closeMoment()" aria-label="关闭">×</button>
    <div class="moment-modal-date" id="mmDate"></div>
    <div class="moment-modal-text" id="mmText"></div>
    <img class="moment-modal-img" id="mmImg" src="" alt="">
  </div>
</div>

<script>
var MOMENTS = <%- JSON.stringify(dynOrdered).replace(/</g, '\\u003c') %>;
function openMoment(i){ var m=MOMENTS[i]; if(!m) return; document.getElementById('mmDate').textContent=m.date||''; document.getElementById('mmText').textContent=m.text||''; var img=document.getElementById('mmImg'); if(m.image){ img.src=m.image; img.style.display='block'; } else { img.style.display='none'; } document.getElementById('momentModal').classList.add('show'); lockBody(); }
function closeMoment(){ document.getElementById('momentModal').classList.remove('show'); unlockBody(); }
</script>
