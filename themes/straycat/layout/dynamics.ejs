<section class="hero">
  <h1 class="hero-title">深夜 <em>碎碎念</em></h1>
  <p class="hero-sub">一些没头没尾的想法，按时间排。</p>
</section>

<div class="sec-hd"><span class="sec-num">live</span><span class="sec-title">动态</span><span class="sec-line"></span></div>

<div class="moment-feed">
  <% var dyn = site.data.dynamics || []; %>
  <% if (dyn.length) { %>
    <% dyn.slice().sort(function(a,b){ return (b.date||'').localeCompare(a.date||''); }).forEach(function(d){ %>
      <article class="moment">
        <div class="moment-head"><span class="feed-type" data-type="rant">动态</span><span class="moment-date"><%= d.date || '' %></span></div>
        <div class="moment-content"><%= d.text %></div>
        <% if (d.image) { %><img class="moment-img" src="<%= d.image %>" alt=""><% } %>
      </article>
    <% }) %>
  <% } else { %>
    <p class="empty">还没有动态，等流浪猫慢慢写。</p>
  <% } %>
</div>
