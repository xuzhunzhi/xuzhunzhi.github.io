<div class="home-top">
  <div class="home-left">
    <section class="hero">
      <h1 class="hero-title">流浪猫的<em>避难所</em></h1>
      <p class="hero-sub">一只被抛弃在尘世之中的猫。<br>感谢尘世还有那些值得猫眷恋的。<br>希望这里成为流浪猫的坟茔。</p>
    </section>

    <% var pinned = site.data.pinned || []; %>
    <% if (pinned.length) { %>
    <div class="sec-hd"><span class="sec-num">pin</span><span class="sec-title">置顶</span><span class="sec-line"></span></div>
    <div class="pinned-wrap">
      <div class="pinned-track" id="pinnedTrack">
        <% pinned.forEach(function(it){ if(it.type==='post'){ var post=null; site.posts.filter(function(p){return (p.source||'').indexOf(it.file)>-1}).each(function(p){if(!post)post=p}); if(post){ %>
          <a class="pin-card" href="<%= url_for(post.path) %>">
            <div class="pin-head"><div class="pin-title"><%= post.title %></div><span class="pin-kind">文章</span></div>
            <div class="pin-desc"><%= post.description || strip_html(post.content).substring(0,80) %></div>
            <div class="pin-meta"><%= date(post.date,'YYYY-MM-DD') %></div>
          </a>
        <% } } else if(it.type==='dynamic'){ var dyn=(site.data.dynamics||[])[it.index]; if(dyn){ %>
          <div class="pin-card" onclick="openMoment(<%= it.index %>)">
            <div class="pin-head"><div class="pin-title">动态</div><span class="pin-kind">动态</span></div>
            <div class="pin-text"><%= dyn.text %></div>
            <div class="pin-meta"><%= dyn.date || '' %></div>
            <% if(dyn.image){ %><img class="pin-img" src="<%= dyn.image %>" alt="" loading="lazy"><% } %>
          </div>
        <% } } }) %>
      </div>
      <button class="pin-nav pin-prev" onclick="pinScroll(-1)" aria-label="上一个">‹</button>
      <button class="pin-nav pin-next" onclick="pinScroll(1)" aria-label="下一个">›</button>
    </div>
    <% } %>
  </div>

  <aside class="home-side">
    <div class="author-card">
      <img class="author-avatar" src="/images/avatar.jpg" alt="流浪猫不是LLM">
      <div class="author-name">流浪猫不是LLM</div>
      <div class="author-bio">我习于冷，志于成冰</div>
      <% var articleCount = site.posts.length; var dynCount = (site.data.dynamics || []).length; %>
      <% var photoCount = 0; (site.data.gallery.albums||[]).forEach(function(a){ (a.images||[]).forEach(function(im){ photoCount++; }); }); %>
      <div class="author-stats">
        <div class="author-stat"><span class="num"><%= articleCount %></span><span class="lbl">文章</span></div>
        <div class="author-stat"><span class="num"><%= dynCount %></span><span class="lbl">动态</span></div>
        <div class="author-stat"><span class="num"><%= photoCount %></span><span class="lbl">照片</span></div>
      </div>
      <a class="author-follow" href="https://github.com/xuzhunzhi" target="_blank" rel="noopener"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg><span>Follow Me</span></a>
    </div>
  </aside>
</div>

<div class="home-bottom">
  <div class="sec-hd"><span class="sec-num">feed</span><span class="sec-title">Latest</span><span class="sec-line"></span></div>

  <div class="feed-list">
    <% var feedItems = []; %>
    <% site.posts.sort('date', -1).each(function(post){ feedItems.push({ kind:'post', key: post.date.format('YYYY-MM-DD HH:mm'), post: post }); }); %>
    <% (site.data.dynamics || []).forEach(function(d){ feedItems.push({ kind:'dyn', key: (d.date||'') + ' 00:00', dyn: d }); }); %>
    <% feedItems.sort(function(a,b){ return b.key.localeCompare(a.key); }); %>
    <% var feedTop = feedItems.slice(0, 12); %>
    <% if (feedTop.length) { %>
      <% feedTop.forEach(function(it){ %>
        <% if (it.kind === 'post') { %>
          <article class="post-card">
            <span class="post-date"><%= date(it.post.date, 'YYYY-MM-DD') %></span>
            <h2 class="post-title"><a href="<%= url_for(it.post.path) %>"><%= it.post.title %></a></h2>
            <span class="post-arrow">→</span>
          </article>
        <% } else { %>
          <article class="post-card" onclick="location.href='<%= url_for('/dynamics/') %>'">
            <span class="post-date"><%= it.dyn.date || '' %></span>
            <h2 class="post-title feed-dyn"><a href="<%= url_for('/dynamics/') %>"><%= it.dyn.text %></a></h2>
            <span class="post-arrow">→</span>
          </article>
        <% } %>
      <% }) %>
    <% } else { %>
      <p class="empty">还没有内容。流浪猫还在路上，等它把这里慢慢填满吧。</p>
    <% } %>
  </div>
</div>
