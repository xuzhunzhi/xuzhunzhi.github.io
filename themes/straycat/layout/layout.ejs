<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <link rel="icon" href="/images/avatar.jpg" type="image/jpeg">
  <link rel="apple-touch-icon" href="/images/avatar.jpg">
  <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-latin-400-normal.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-latin-600-normal.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-latin-400-italic.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/syne-latin-600-normal.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-mono-latin-400-normal.woff2" crossorigin>
  <link rel="stylesheet" href="<%= url_for('/css/style.css') %>?v=47">
</head>
<body>
  <% var siteMeta = site.data.site || {}; %>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="<%= url_for('/') %>"><%= siteMeta.headerTitle || 'Shelter' %></a>
      <nav class="site-nav">
        <a href="<%= url_for('/') %>">首页</a>
        <a href="<%= url_for('/articles/') %>">文章</a>
        <a href="<%= url_for('/images/') %>">图片</a>
        <a href="<%= url_for('/dynamics/') %>">动态</a>
        <a href="<%= url_for('/anime/') %>">番剧</a>
        <a href="<%= url_for('/about/') %>">关于</a>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <%- body %>
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <% var friends = Array.isArray(site.data.friends) ? site.data.friends : theme.friends; %>
      <% if (friends && friends.length) { %>
        <div class="footer-friends">
          <span class="friends-label">友链 / Friends</span>
          <div class="friends-list">
            <% friends.forEach(function(f){ %>
              <a class="friend" href="<%= f.url || '#' %>" target="_blank" rel="noopener" title="<%= f.desc || '' %>"><%= f.name %></a>
            <% }) %>
          </div>
        </div>
      <% } %>
      <div class="footer-bottom">
        <span>© <%= new Date().getFullYear() %> <%= config.title %> · <%= siteMeta.footerByline || 'by 流浪猫不是LLM' %></span>
        <span>流浪猫不需要和家猫走一样的路</span>
      </div>
      <p class="footer-credit">本站由 <a href="https://hexo.io/zh-cn/" target="_blank" rel="noopener">Hexo</a> 驱动，托管于 <a href="https://pages.github.com/" target="_blank" rel="noopener">GitHub Pages</a>。字体来自 <a href="https://fontsource.org/" target="_blank" rel="noopener">Fontsource</a>。</p>
    </div>
  </footer>

  <% if (theme.music) { %>
    <button class="music-btn" id="musicBtn" onclick="togglePlayer()" title="音乐" aria-label="背景音乐"><span class="music-note">♪</span></button>
    <div class="music-card" id="musicCard">
      <div class="music-head"><span class="music-title" id="musicTitle">播放器</span><button class="music-close" onclick="togglePlayer()" aria-label="关闭">×</button></div>
      <div class="music-controls">
        <button class="music-ctrl" onclick="musicPrev()" aria-label="上一曲">⏮</button>
        <button class="music-ctrl music-play" id="musicPlay" onclick="musicToggle()" aria-label="播放/暂停">▶</button>
        <button class="music-ctrl" onclick="musicNext()" aria-label="下一曲">⏭</button>
      </div>
      <div class="music-vol"><span>音量</span><input type="range" id="musicVol" min="0" max="1" step="0.05" value="0.8" oninput="a.volume=+this.value"></div>
      <div class="music-list" id="musicList"></div>
    </div>
    <audio id="bgMusic" preload="none"></audio>
    <script>
      (function(){
        var a=document.getElementById('bgMusic'), index=0;
        var MUSIC = <%- JSON.stringify((site.data.music||[]).length?site.data.music:(theme.music.url?[{title:(theme.music.title||'音乐'),url:theme.music.url}]:[])) %>;
        window.a=a;
        function rendList(){ var el=document.getElementById('musicList'); el.innerHTML=MUSIC.map(function(m,i){ return '<div class="music-item'+(i===index?' cur':'')+'" onclick="playAt('+i+')"><span class="music-item-title">'+m.title+'</span><span class="music-item-tag">'+(i===index?'●':'')+'</span></div>'; }).join('')||'<div class="music-item muted">暂无歌曲</div>'; }
        function loadTrack(){ var m=MUSIC[index]; if(!m) return; a.src=m.url; document.getElementById('musicTitle').textContent=m.title||'音乐'; rendList(); }
        window.playAt=function(i){ index=i; loadTrack(); a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; };
        window.musicToggle=function(){ if(a.paused){ a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; } else { a.pause(); document.getElementById('musicPlay').textContent='▶'; } };
        window.musicNext=function(){ if(!MUSIC.length) return; index=(index+1)%MUSIC.length; loadTrack(); a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; };
        window.musicPrev=function(){ if(!MUSIC.length) return; index=(index-1+MUSIC.length)%MUSIC.length; loadTrack(); a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; };
        window.togglePlayer=function(){ var c=document.getElementById('musicCard'); if(!c) return; if(c.classList.contains('show')){ closeModal(c); } else { c.classList.remove('closing'); c.classList.add('show'); saveState(); } };
        document.addEventListener('pointerdown',function(e){ if(window.matchMedia('(max-width: 600px)').matches){ var c=document.getElementById('musicCard'), b=document.getElementById('musicBtn'); if(c&&c.classList.contains('show')&&!c.contains(e.target)&&!b.contains(e.target)) closeModal(c); } });
        function saveState(){ try{ sessionStorage.setItem('musicState', JSON.stringify({i:index,t:a.currentTime||0,p:!a.paused,v:a.volume})); }catch(e){} }
        a.addEventListener('timeupdate', saveState);
        a.addEventListener('play', function(){ document.getElementById('musicPlay').textContent='⏸'; saveState(); });
        a.addEventListener('pause', function(){ document.getElementById('musicPlay').textContent='▶'; saveState(); });
        a.addEventListener('ended',function(){ musicNext(); saveState(); });
        window.playAt=function(i){ index=i; loadTrack(); a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; saveState(); };
        window.musicToggle=function(){ if(a.paused){ a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; } else { a.pause(); document.getElementById('musicPlay').textContent='▶'; } saveState(); };
        window.musicNext=function(){ if(!MUSIC.length) return; index=(index+1)%MUSIC.length; loadTrack(); a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; saveState(); };
        window.musicPrev=function(){ if(!MUSIC.length) return; index=(index-1+MUSIC.length)%MUSIC.length; loadTrack(); a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; saveState(); };
        a.volume=0.8;
        /// restore across page navigations
        (function(){ try{ var s=JSON.parse(sessionStorage.getItem('musicState')||'null'); if(!s) return; index=Math.min(Math.max(s.i||0,0), Math.max(MUSIC.length-1,0)); loadTrack(); a.volume=(s.v!=null?s.v:0.8); document.getElementById('musicVol').value=a.volume; var resumed=false; function resume(){ if(resumed) return; resumed=true; ['pointerdown','keydown','touchstart'].forEach(function(ev){ document.removeEventListener(ev,resume); }); if(a.paused) a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; } if(s.t){ a.addEventListener('loadedmetadata', function once(){ a.removeEventListener('loadedmetadata', once); a.currentTime=s.t; if(s.p){ a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; } }); } else if(s.p){ a.play().catch(function(){}); document.getElementById('musicPlay').textContent='⏸'; } if(s.p){ ['pointerdown','keydown','touchstart'].forEach(function(ev){ document.addEventListener(ev,resume); }); } }catch(e){} })();
      })();
    </script>
  <% } %>

  <div class="imgdetail" id="imgdetail" onclick="if(event.target===this)closeLightbox()">
    <div class="imgdetail-inner">
      <button class="moment-x" onclick="closeLightbox()" aria-label="关闭">×</button>
      <div class="imgdetail-media"><img id="lightboxImg" alt=""></div>
      <div class="imgdetail-info" id="imgdetailInfo"></div>
    </div>
  </div>

  <div class="moment-modal" id="momentModal" onclick="if(event.target===this)closeMoment()">
    <div class="moment-modal-inner">
      <button class="moment-x" onclick="closeMoment()" aria-label="关闭">×</button>
      <div class="moment-modal-kicker">dynamic / detail</div>
      <div class="moment-modal-author"><img src="/images/avatar.jpg" alt=""><div><strong>许纯之_Official</strong><time class="moment-modal-date" id="mmDate"></time></div></div>
      <div class="moment-modal-text" id="mmText"></div>
      <img class="moment-modal-img" id="mmImg" src="" alt="">
      <div class="moment-modal-actions" id="mmActions"></div>
      <div class="moment-comments moment-modal-comments" id="mmComments" onclick="event.stopPropagation()"><div class="moment-comments-title">评论 / Comments</div></div>
    </div>
  </div>

  <div class="share-modal" id="shareModal" onclick="if(event.target===this)closeShare()">
    <div class="share-modal-inner">
      <button class="moment-x" onclick="closeShare()" aria-label="关闭">×</button>
      <div class="share-modal-kicker">share / pass it on</div>
      <h2 class="share-modal-title" id="shareTitle">分享</h2>
      <div class="share-platforms" id="sharePlatforms"></div>
      <div class="share-tools" id="shareTools"></div>
      <p class="share-tip" id="shareTip"></p>
    </div>
  </div>

  <button class="back-top" id="backTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="回到顶部">↑ <span>TOP</span></button>

  <div class="timeline-menu-modal" id="timelineMenuModal" onclick="if(event.target===this)closeTimelineMenu()">
    <div class="timeline-menu-inner" role="dialog" aria-modal="true" aria-labelledby="timelineMenuTitle">
      <button class="moment-x" onclick="closeTimelineMenu()" aria-label="关闭">×</button>
      <div class="image-calendar-kicker">CONTENTS</div>
      <h2 id="timelineMenuTitle">时间目录</h2>
      <nav id="timelineMenuBody"></nav>
    </div>
  </div>

  <div class="image-calendar-modal" id="archiveTimelineCalendar" onclick="if(event.target===this)closeArchiveTimelineCalendar()">
    <div class="image-calendar-inner" role="dialog" aria-modal="true" aria-labelledby="archiveCalendarTitle">
      <button class="moment-x" onclick="closeArchiveTimelineCalendar()" aria-label="关闭">×</button>
      <div class="image-calendar-head"><button class="image-calendar-arrow" id="archiveCalendarPrev" type="button" onclick="shiftArchiveTimelineCalendar(-1)" aria-label="上一个月">←</button><div class="image-calendar-heading"><div class="image-calendar-kicker">ARCHIVE TIMELINE</div><div class="image-calendar-title-line"><button class="image-calendar-title-button year" id="archiveCalendarYear" type="button" onclick="showArchiveTimelineYears()">选择年份</button><span class="image-calendar-separator" aria-hidden="true">/</span><button class="image-calendar-title-button" id="archiveCalendarMonth" type="button" onclick="showArchiveTimelineMonths()">选择月份</button></div></div><button class="image-calendar-arrow" id="archiveCalendarNext" type="button" onclick="shiftArchiveTimelineCalendar(1)" aria-label="下一个月">→</button></div>
      <div id="archiveCalendarBody"></div>
    </div>
  </div>

  <script>
    var MOMENTS = <%- JSON.stringify((site.data.dynamics||[])).replace(/</g, '\\u003c') %>;
    function escHtml(s){ return String(s||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
    function openTimelineMenu(source){
      var modal=document.getElementById('timelineMenuModal'),body=document.getElementById('timelineMenuBody'); if(!modal||!body||!source)return;
      var isPost=source.classList.contains('post-toc'),links=Array.prototype.slice.call(source.querySelectorAll('a')); if(isPost){var list=source.querySelector('.post-toc-list');body.innerHTML=list?'<div class="timeline-menu-post-list post-toc-list">'+list.innerHTML+'</div>':'<p class="timeline-menu-empty">这里还没有目录内容</p>';}else{body.innerHTML=links.length?links.map(function(link){return '<a href="'+escHtml(link.getAttribute('href')||'#')+'" data-target="'+escHtml(link.getAttribute('data-target')||'')+'">'+escHtml(link.textContent.trim())+'</a>';}).join(''):'<p class="timeline-menu-empty">这里还没有目录内容</p>';}
      document.getElementById('timelineMenuTitle').textContent=source.classList.contains('post-toc')?'文章目录':'时间目录';
      body.querySelectorAll('a').forEach(function(link){link.addEventListener('click',function(e){var raw=link.getAttribute('data-target')||link.getAttribute('href')||'';if(raw.charAt(0)!=='#')return;e.preventDefault();closeTimelineMenu();setTimeout(function(){scrollToContentAnchor(raw);},260);});});
      modal.classList.remove('closing');modal.classList.add('show');lockBody();
    }
    function closeTimelineMenu(){ closeModal(document.getElementById('timelineMenuModal')); }
    function scrollToContentAnchor(raw){var id=String(raw||'').replace(/^#/,'');try{id=decodeURIComponent(id);}catch(e){}var target=document.getElementById(id);if(!target)return;history.replaceState(null,'','#'+encodeURIComponent(id));var offset=88,top=window.pageYOffset+target.getBoundingClientRect().top-offset;window.scrollTo({top:Math.max(0,top),behavior:'smooth'});}
    var archiveCalendarState={kind:'',months:{},current:'',view:'month',yearStart:0};
    function archiveCalendarTarget(id){return String(id||'').replace(/[^0-9A-Za-z_-]/g,'-');}
    function setArchiveCalendarHeader(view,key){
      var month=document.getElementById('archiveCalendarMonth'),year=document.getElementById('archiveCalendarYear'),prev=document.getElementById('archiveCalendarPrev'),next=document.getElementById('archiveCalendarNext');if(!month||!year)return;
      var y=/^\d{4}-\d{2}$/.test(key)?key.slice(0,4):String(key||'').slice(0,4);month.disabled=view!=='month';year.disabled=view==='years';prev.style.visibility=next.style.visibility='visible';
      if(view==='month'){month.textContent=/^\d{4}-\d{2}$/.test(key)?key.slice(5)+'月':'选择月份';year.textContent=y?y+'年':'选择年份';}
      else if(view==='months'){month.textContent='选择月份';year.textContent=y+'年';}
      else{month.textContent='选择年份';year.textContent=archiveCalendarState.yearStart+'—'+(archiveCalendarState.yearStart+19);}
    }
    function openArchiveTimelineCalendar(config,key){
      var modal=document.getElementById('archiveTimelineCalendar'),keys=Object.keys((config&&config.months)||{}).sort(function(a,b){return b.localeCompare(a);});if(!modal||!keys.length)return;archiveCalendarState={kind:config.kind||'archive',months:config.months||{},current:key&&config.months[key]?key:keys[0],view:'month',yearStart:0};renderArchiveTimelineCalendar(archiveCalendarState.current);modal.classList.remove('closing');modal.classList.add('show');lockBody();
    }
    function renderArchiveTimelineMonths(year){
      var body=document.getElementById('archiveCalendarBody'),labels=['一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];if(!body)return;archiveCalendarState.view='months';archiveCalendarState.current=year+'-01';setArchiveCalendarHeader('months',archiveCalendarState.current);body.innerHTML='<div class="image-calendar-months">'+labels.map(function(label,i){var key=year+'-'+('0'+(i+1)).slice(-2),days=archiveCalendarState.months[key]||{},count=Object.keys(days).length;return '<button type="button" class="'+(count?'has-images':'')+'" data-archive-month="'+key+'">'+label+(count?'<small>'+count+'天有记录</small>':'')+'</button>';}).join('')+'</div>';
    }
    function showArchiveTimelineMonths(){var y=/^\d{4}-\d{2}$/.test(archiveCalendarState.current)?+archiveCalendarState.current.slice(0,4):new Date().getFullYear();renderArchiveTimelineMonths(y);}
    function renderArchiveTimelineYears(center){var body=document.getElementById('archiveCalendarBody');if(!body)return;archiveCalendarState.view='years';archiveCalendarState.yearStart=(+center||new Date().getFullYear())-9;setArchiveCalendarHeader('years',String(archiveCalendarState.yearStart));var html='<div class="image-calendar-years">';for(var y=archiveCalendarState.yearStart;y<archiveCalendarState.yearStart+20;y++)html+='<button type="button" data-archive-year="'+y+'">'+y+'</button>';body.innerHTML=html+'</div>';}
    function showArchiveTimelineYears(){var y=/^\d{4}-\d{2}$/.test(archiveCalendarState.current)?+archiveCalendarState.current.slice(0,4):new Date().getFullYear();renderArchiveTimelineYears(y);}
    function renderArchiveTimelineCalendar(key){
      var body=document.getElementById('archiveCalendarBody'),days=archiveCalendarState.months[key]||{};if(!body)return;archiveCalendarState.view='month';archiveCalendarState.current=key;setArchiveCalendarHeader('month',key);if(!/^\d{4}-\d{2}$/.test(key)){body.innerHTML='<p class="image-calendar-tip">这里还没有可用的日期记录</p>';return;}
      var parts=key.split('-'),year=+parts[0],month=+parts[1],total=new Date(year,month,0).getDate(),first=(new Date(year,month-1,1).getDay()+6)%7,html='<div class="image-calendar-week"><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span></div><div class="image-calendar-grid">';for(var i=0;i<first;i++)html+='<span class="image-calendar-empty"></span>';for(var d=1;d<=total;d++){var rec=days[String(d)],target=rec&&rec.target,count=rec&&rec.count||0;if(target){html+='<a class="has-images" href="#'+archiveCalendarTarget(target)+'" data-archive-jump="'+archiveCalendarTarget(target)+'" aria-label="'+d+'日，有'+count+'条记录"><b>'+d+'</b><small>'+count+'条</small></a>';}else html+='<span>'+d+'</span>';}for(var empty=first+total;empty<42;empty++)html+='<span class="image-calendar-empty"></span>';body.innerHTML=html+'</div><p class="image-calendar-tip"><span aria-hidden="true"></span>金色日期有记录 · 点击日期跳转</p>';
    }
    function shiftArchiveTimelineCalendar(delta){if(archiveCalendarState.view==='month'&&/^\d{4}-\d{2}$/.test(archiveCalendarState.current)){var p=archiveCalendarState.current.split('-'),d=new Date(+p[0],+p[1]-1+delta,1);renderArchiveTimelineCalendar(d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2));}else if(archiveCalendarState.view==='months'){renderArchiveTimelineMonths(+archiveCalendarState.current.slice(0,4)+delta);}else renderArchiveTimelineYears(archiveCalendarState.yearStart+9+delta*20);}
    function closeArchiveTimelineCalendar(){closeModal(document.getElementById('archiveTimelineCalendar'));}
    (function(){var body=document.getElementById('archiveCalendarBody');if(!body)return;body.addEventListener('click',function(e){var month=e.target.closest('[data-archive-month]'),year=e.target.closest('[data-archive-year]'),jump=e.target.closest('[data-archive-jump]');if(month){renderArchiveTimelineCalendar(month.getAttribute('data-archive-month'));return;}if(year){renderArchiveTimelineMonths(+year.getAttribute('data-archive-year'));return;}if(jump){e.preventDefault();var id=jump.getAttribute('data-archive-jump');closeArchiveTimelineCalendar();setTimeout(function(){scrollToContentAnchor(id);},260);}});})();
    function momentImageList(m){ return m.images&&m.images.length?m.images:(m.image?[m.image]:[]); }
    function actionIcon(name){ if(name==='like') return '<svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 8.55a5.5 5.5 0 0 0-8.84-1.27 5.5 5.5 0 0 0-8.84 1.27C1.44 12.33 5.5 16 12 20.5c6.5-4.5 10.56-8.17 8.84-11.95Z"/></svg>'; if(name==='comment') return '<svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H7l-4 3v-6.15A7.5 7.5 0 1 1 20 11.5Z"/><path d="M8 11.5h.01M12 11.5h.01M16 11.5h.01"/></svg>'; return '<svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a7 7 0 0 0-12-2"/><path d="M6 6V2m0 4h4"/><path d="M6 16a7 7 0 0 0 12 2"/><path d="M18 18v4m0-4h-4"/></svg>'; }
    function openMoment(i){ var m=MOMENTS[i]; if(!m) return; document.getElementById('mmDate').textContent=m.date||''; document.getElementById('mmText').textContent=m.text||''; var img=document.getElementById('mmImg'), ims=momentImageList(m); if(ims.length===1){ img.src=ims[0]; img.style.display='block'; } else { img.style.display='none'; } var old=document.getElementById('mmGallery'); if(old) old.remove(); if(ims.length>1){ var g=document.createElement('div');g.id='mmGallery';g.className='moment-modal-gallery';g.innerHTML=ims.map(function(src){return '<img src="'+escHtml(src)+'" alt="">';}).join('');document.querySelector('.moment-modal-inner').appendChild(g); } var mc=document.getElementById('mmComments');if(mc){mc.classList.remove('show');mc.hidden=true;mc.innerHTML='<div class="moment-comments-title">评论 / Comments</div>';delete mc.dataset.mounted;} var acts=document.getElementById('mmActions');if(acts)acts.innerHTML='<button class="content-action" onclick="toggleLike('+i+',this)">'+actionIcon('like')+'<span>点赞</span></button><button class="content-action" onclick="openComment('+i+')">'+actionIcon('comment')+'<span>评论</span></button><button class="content-action" onclick="shareMoment('+i+')">'+actionIcon('share')+'<span>转发</span></button>'; document.getElementById('momentModal').classList.add('show'); lockBody(); }
    function closeMoment(){ closeModal(document.getElementById('momentModal')); }
    function toggleLike(i,btn){ var key='moment-like-'+i,liked=localStorage.getItem(key)==='1'; liked=!liked; try{localStorage.setItem(key,liked?'1':'0');}catch(e){} btn.classList.toggle('liked',liked); btn.innerHTML=actionIcon('like')+'<span>点赞</span>'; }
    function mountMomentComments(i,host){ if(!host||host.dataset.mounted==='1') return; host.dataset.mounted='1'; var m=MOMENTS[i]||{},script=document.createElement('script');script.src='https://utteranc.es/client.js';script.async=true;script.setAttribute('repo','xuzhunzhi/xuzhunzhi.github.io');script.setAttribute('issue-term','dynamic-'+i+'-'+String(m.date||'').replace(/[^0-9A-Za-z-]+/g,'-'));script.setAttribute('label','动态评论');script.setAttribute('theme','github-dark');script.setAttribute('crossorigin','anonymous');host.appendChild(script); }
    function openComment(i){ var modal=document.getElementById('momentModal'),host=modal&&modal.classList.contains('show')?document.getElementById('mmComments'):document.getElementById('moment-comments-'+i); if(!host) return; var open=host.classList.contains('show');host.classList.toggle('show',!open);host.hidden=open;if(!open){mountMomentComments(i,host);setTimeout(function(){host.scrollIntoView({behavior:'smooth',block:'nearest'});},40);} }
    function shareMoment(i){var m=MOMENTS[i]||{},ims=momentImageList(m);openShare('dynamic',i,location.origin+'<%= url_for('/dynamics/') %>#moment-'+i,'动态 · '+(m.date||''),m.date||'',m.text||'',ims[0]||'');}
    function togglePostLike(btn){var key='post-like-'+location.pathname,liked=localStorage.getItem(key)==='1';liked=!liked;try{localStorage.setItem(key,liked?'1':'0');}catch(e){}btn.classList.toggle('liked',liked);btn.innerHTML=actionIcon('like')+'<span>点赞</span>';}
    function openPostComment(){var el=document.querySelector('.comments');if(!el)return;el.classList.add('comments-focus');el.scrollIntoView({behavior:'smooth',block:'start'});setTimeout(function(){el.classList.remove('comments-focus');},1200);}
    function switchView(btn, name){
      var root = btn.closest('.ptoggle'); if(!root) return;
      var next = root.querySelector('#view-'+name), current = Array.prototype.slice.call(root.querySelectorAll('.view-panel')).find(function(panel){ return getComputedStyle(panel).display !== 'none'; });
      if(!next || !current || current===next || root.dataset.switching==='1') return;
      root.querySelectorAll('.toggle-btn').forEach(function(b){ b.classList.toggle('active', b===btn); });
      if(!root.classList.contains('animated-view-toggle')){ root.querySelectorAll('.view-panel').forEach(function(p){ p.style.display = p===next ? '' : 'none'; }); return; }
      var itemSelector='.article-list-card,.collection-card,.image-day-images .image-timeline-media,.album-card', leaving=Array.prototype.slice.call(current.querySelectorAll(itemSelector)), entering=Array.prototype.slice.call(next.querySelectorAll(itemSelector)), count=Math.max(leaving.length,entering.length), stagger=45, exitDuration=360, enterDuration=480, wait=Math.min(900,exitDuration+Math.max(0,count-1)*stagger);
      var reduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function mark(items, className){items.forEach(function(item,index){item.style.animationDelay=(index*stagger)+'ms';if(className==='view-item-entering')item.style.setProperty('--switch-final-transform',getComputedStyle(item).transform);item.classList.add(className);});}
      function clear(items,className){items.forEach(function(item){if(className==='view-item-entering'){item.style.transition='none';item.style.animation='none';item.style.setProperty('--switch-final-transform',getComputedStyle(item).transform);}item.classList.remove(className);item.style.removeProperty('animation-delay');item.style.removeProperty('--switch-final-transform');if(className==='view-item-entering'){item.style.removeProperty('animation');item.style.removeProperty('transition');}});}
      function showNext(){current.style.display='none';clear(leaving,'view-item-leaving');next.style.display='';mark(entering,'view-item-entering');window.setTimeout(function(){clear(entering,'view-item-entering');root.dataset.switching='';},Math.min(900,enterDuration+Math.max(0,entering.length-1)*stagger));}
      root.dataset.switching='1';root.dataset.switchDirection=(name==='collection'||name==='album')?'forward':'backward';
      if(reduced||!count){showNext();return;}
      mark(leaving,'view-item-leaving');window.setTimeout(showNext,wait);
    }
    function fmtSize(b){ b=+b||0; if(b<1024) return b+' B'; if(b<1048576) return (b/1024).toFixed(1)+' KB'; return (b/1048576).toFixed(2)+' MB'; }
    function parseExif(buf){
      var out={}; if(!buf) return out; var bytes=buf instanceof ArrayBuffer?new Uint8Array(buf):new Uint8Array(buf.buffer,buf.byteOffset||0,buf.byteLength||buf.length); if(bytes.length<4||bytes[0]!==0xFF||bytes[1]!==0xD8) return out;
      var view=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength),u16=function(o,l){return view.getUint16(o,l)},u32=function(o,l){return view.getUint32(o,l)}; var off=2,tiff=-1;
      while(off+4<=bytes.length){if(bytes[off]!==0xFF){off++;continue}var marker=bytes[off+1],size=u16(off+2,false);if(size<2||off+2+size>bytes.length)break;if(marker===0xE1){var sig='';for(var k=0;k<6;k++)sig+=String.fromCharCode(bytes[off+4+k]);if(sig==='Exif\0\0'){tiff=off+10;break}}off+=2+size}
      if(tiff<0||tiff+8>bytes.length)return out;var little=u16(tiff,false)===0x4949;if(!little&&u16(tiff,false)!==0x4D4D)return out;var t=function(o){return u16(o,little)},t32=function(o){return u32(o,little)};function ratio(o){var n=t32(o),d=t32(o+4);return d?n/d:0}function fmt(v){return typeof v==='number'&&isFinite(v)?(Math.round(v*1000)/1000).toString():''}function first(v){return Array.isArray(v)?v[0]:v}
      function value(type,cnt,pos){var unit=type===1||type===2||type===7?1:(type===3?2:(type===4?4:(type===5?8:0)));if(!unit)return null;var bytesLen=unit*cnt,dp=bytesLen<=4?pos:tiff+t32(pos);if(dp<0||dp+bytesLen>bytes.length)return null;if(type===2){var s='';for(var a=0;a<cnt;a++)s+=String.fromCharCode(bytes[dp+a]);return s.replace(/\0+$/,'').trim()}if(type===3){var ar=[];for(var b=0;b<cnt;b++)ar.push(t(dp+b*2));return ar}if(type===4){var ar4=[];for(var c=0;c<cnt;c++)ar4.push(t32(dp+c*4));return ar4}if(type===5){var ar5=[];for(var d=0;d<cnt;d++)ar5.push(ratio(dp+d*8));return ar5}return bytes[dp]}
      function scan(ifd,cb){if(!ifd||ifd<0||ifd+2>bytes.length)return;var n=t(ifd);for(var i=0;i<n;i++){var e=ifd+2+i*12;if(e+12>bytes.length)break;cb(t(e),t(e+2),t32(e+4),value(t(e+2),t32(e+4),e+8))}}
      var gps={};function gpsScan(ifd){scan(ifd,function(tag,type,cnt,v){if(tag===1)gps.latRef=first(v);else if(tag===2)gps.lat=v;else if(tag===3)gps.lngRef=first(v);else if(tag===4)gps.lng=v})}
      function scanIfd(ifd){scan(ifd,function(tag,type,cnt,v){if(tag===0x010F)out.Make=first(v);else if(tag===0x0110)out.Model=first(v);else if(tag===0x829D)out.FNumber=fmt(first(v));else if(tag===0x829A)out.ExposureTime=fmt(first(v));else if(tag===0x8827)out.ISO=first(v);else if(tag===0x920A)out.FocalLength=fmt(first(v));else if(tag===0xA405)out.FocalLength35=fmt(first(v));else if(tag===0x9209)out.Flash=first(v);else if(tag===0x9003)out.DateTimeOriginal=first(v);else if(tag===0x8769)scanIfd(tiff+first(v));else if(tag===0x8825)gpsScan(tiff+first(v))})}
      scanIfd(tiff+t32(tiff+4));if(gps.lat&&gps.lng){function dms(v){return Array.isArray(v)&&v.length>=3?v[0]+v[1]/60+v[2]/3600:NaN}var lat=dms(gps.lat),lng=dms(gps.lng);if(/^S/i.test(gps.latRef))lat=-lat;if(/^W/i.test(gps.lngRef))lng=-lng;if(!isNaN(lat)&&!isNaN(lng)){out.GPS=lat.toFixed(6)+', '+lng.toFixed(6);out.GPSUrl='https://www.google.com/maps?q='+lat.toFixed(6)+','+lng.toFixed(6)}}return out;
    }
    function openLightbox(src){
      var lb=document.getElementById('imgdetail'),im=document.getElementById('lightboxImg');
      if(!lb||!im) return; lb.classList.add('show'); im.src=src; lockBody();
      var info=document.getElementById('imgdetailInfo'); info.innerHTML='<div class="imgdetail-loading">读取图片信息…</div>';
      var tmp=new Image(); tmp.onload=function(){ var dims=tmp.naturalWidth+' × '+tmp.naturalHeight; renderImgInfo(info,dims,src); }; tmp.src=src;
    }
    function fmtKB(s){ var b=parseInt(s,10); if(!b) return ''; if(b<1024) return b+' B'; if(b<1048576) return (b/1024).toFixed(1)+' KB'; return (b/1048576).toFixed(2)+' MB'; }
    function toNum(s){ if(s==null) return NaN; var p=String(s).trim().split('/'); if(p.length===2){ var n=+p[0],d=+p[1]; return d? n/d : NaN; } return +p[0]; }
    function flashStr(v){ v=+v; if(isNaN(v)) return ''; if(v&1) return '闪光'; if(v===0) return '无闪光'; if(v===16||v===24) return '未闪光(自动)'; if(v===25||v===7) return '闪光(自动)'; return (v&1)?'闪光':'未闪光'; }
    function fmtExif(ex){ if(!ex) return {}; var out={}; ['Make','Model','ISO','DateTimeOriginal'].forEach(function(k){ if(ex[k]) out[k]=ex[k]; }); if(ex.FNumber){ var fn=toNum(ex.FNumber); if(!isNaN(fn)) out.FNumber='f/'+(fn%1? fn.toFixed(1): fn); } if(ex.ExposureTime){ var et=String(ex.ExposureTime).trim(); var p=et.split('/'); if(p.length===2){ var n=+p[0],d=+p[1]; if(d&&n>0&&n<d) out.ExposureTime='1/'+Math.round(d/n)+'s'; else out.ExposureTime=(n/d).toFixed(1)+'s'; } else { var v=+et; if(v>0&&v<1) out.ExposureTime='1/'+Math.round(1/v)+'s'; else out.ExposureTime=(v|0)+'s'; } } if(ex.FocalLength35){ var f35=toNum(ex.FocalLength35); out.FocalLength=((!isNaN(f35))? f35 : ex.FocalLength35)+'mm'; } else if(ex.FocalLength){ var fl=toNum(ex.FocalLength); out.FocalLength=((!isNaN(fl))? fl : ex.FocalLength)+'mm'; } if(ex.Flash){ var fs=flashStr(ex.Flash); if(fs) out.Flash=fs; } if(ex.GPS){ out.GPS=ex.GPS; out.GPSUrl=ex.GPSUrl; } return out; }
    function renderImgInfo(info,dims,src){
      fetch('/image_meta.json?t=' + Date.now()).then(function(r){return r.json()}).then(function(meta){
        var m=meta[src]||meta[decodeURIComponent(src||'')]||meta[(src||'').replace(/%2F/gi,'/')]||meta[(src||'').replace(/\\/g,'/')]; if(!m){ throw new Error('nom'); }
        var fe=fmtExif(m.exif||{});
        var rows='<div class="imgdetail-rows">'; rows+=row('分辨率',m.width+' × '+m.height); if(m.size) rows+=row('文件大小',fmtKB(m.size)); rows+='</div>';
        var exr=''; ['Make','Model','FNumber','ExposureTime','ISO','FocalLength','Flash'].forEach(function(k){ if(fe[k]) exr+=row({Make:'厂商',Model:'拍摄机型',FNumber:'光圈',ExposureTime:'快门',ISO:'ISO',FocalLength:'焦距',Flash:'闪光灯'}[k],fe[k]); });
        if(fe.DateTimeOriginal) exr+=row('拍摄时间',fe.DateTimeOriginal);
        if(fe.GPS) exr+='<div class="imgdetail-row"><span class="k">地理位置</span><span class="v"><a href="'+fe.GPSUrl+'" target="_blank" rel="noopener">'+fe.GPS+'</a></span></div>';
        info.innerHTML=rows+(exr?'<div class="imgdetail-sub">EXIF</div><div class="imgdetail-rows">'+exr+'</div>':'');
      }).catch(function(){
        fetch(src).then(function(r){ return r.arrayBuffer() }).then(function(buf){ var ex=parseExif(buf); var rows='<div class="imgdetail-rows">'; rows+=row('分辨率',dims); rows+=row('文件大小',fmtSize(buf.byteLength)); if(ex.DateTimeOriginal) rows+=row('拍摄时间',ex.DateTimeOriginal); rows+='</div>'; info.innerHTML=rows; }).catch(function(){ info.innerHTML='<div class="imgdetail-rows">'+row('分辨率',dims)+'</div>'; });
      });
      function row(k,v){ return '<div class="imgdetail-row"><span class="k">'+k+'</span><span class="v">'+v+'</span></div>'; }
    }
    function closeLightbox(){ closeModal(document.getElementById('imgdetail')); }
    function lockBody(){ var sw=window.innerWidth-document.documentElement.clientWidth; document.body.style.overflow='hidden'; document.body.style.paddingRight=(sw>0?sw+'px':''); }
    function unlockBody(){ document.body.style.overflow=''; document.body.style.paddingRight=''; }
    function closeModal(el){ if(!el) return; if(el.classList.contains('closing')) return; el.classList.add('closing'); var done=false; var fin=function(){ if(done) return; done=true; el.classList.remove('show','closing'); unlockBody(); }; setTimeout(fin, 240); }
    function pinScroll(dir){ var t=document.getElementById('pinnedTrack'); if(t) t.scrollBy({left:dir*(t.clientWidth*0.6),behavior:'smooth'}); }
    var shareState={kind:'',index:-1,url:'',title:'',date:'',text:'',image:''};
    function openShare(kind,index,url,title,date,text,image){
      shareState={kind:kind||'',index:index==null?-1:index,url:url||location.href,title:title||document.title,date:date||'',text:text||'',image:image||''};
      var modal=document.getElementById('shareModal'), platforms=document.getElementById('sharePlatforms'), tools=document.getElementById('shareTools'); if(!modal) return;
      var u=encodeURIComponent(shareState.url), t=encodeURIComponent(shareState.title), full=encodeURIComponent(shareState.title+(shareState.date?' · '+shareState.date:''));
      platforms.innerHTML='<a class="share-platform facebook" href="https://www.facebook.com/sharer/sharer.php?u='+u+'" target="_blank" rel="noopener"><b>f</b><span>Facebook</span></a><a class="share-platform x" href="https://twitter.com/intent/tweet?url='+u+'&text='+t+'" target="_blank" rel="noopener"><b>𝕏</b><span>X</span></a><button class="share-platform wechat" onclick="showShareTip(\'微信请使用二维码或复制链接分享\')"><b>微</b><span>微信</span></button><a class="share-platform weibo" href="https://service.weibo.com/share/share.php?url='+u+'&title='+full+'" target="_blank" rel="noopener"><b>微</b><span>微博</span></a><a class="share-platform qq" href="https://connect.qq.com/widget/shareqq/index.html?url='+u+'&title='+t+'" target="_blank" rel="noopener"><b>Q</b><span>QQ</span></a>';
      var copyLabel=kind==='dynamic'?'复制动态页链接和动态时间':'复制文章链接';
      tools.innerHTML='<button class="share-tool" onclick="copyShareLink()">↗ <span>'+copyLabel+'</span></button><button class="share-tool" onclick="saveShareCard()">▣ <span>保存这条详情图片</span></button>';
      document.getElementById('shareTitle').textContent=shareState.title||'分享'; document.getElementById('shareTip').textContent=''; modal.classList.remove('closing'); modal.classList.add('show'); lockBody();
    }
    function closeShare(){ closeModal(document.getElementById('shareModal')); }
    function showShareTip(s){ var el=document.getElementById('shareTip'); if(el) el.textContent=s; }
    function copyShareLink(){ var s=shareState.url+(shareState.kind==='dynamic'&&shareState.date?'\n动态时间：'+shareState.date:''); if(navigator.clipboard){ navigator.clipboard.writeText(s).then(function(){showShareTip('已复制到剪贴板');}).catch(function(){showShareTip(s);}); } else { showShareTip(s); } }
    function saveShareCard(){
      var s=shareState, canvas=document.createElement('canvas'), ctx=canvas.getContext('2d'), W=1200, pad=90, lines=[]; canvas.width=W; canvas.height=s.image?900:680; ctx.fillStyle='#0a0a08'; ctx.fillRect(0,0,W,canvas.height); ctx.fillStyle='#d4a24e'; ctx.font='600 24px Arial'; ctx.fillText('流浪猫的避难所  /  '+(s.kind==='dynamic'?'DYNAMIC':'ARTICLE'),pad,76); ctx.fillStyle='#f0ece4'; ctx.font='600 42px Arial'; wrapCanvas(ctx,s.title||'',pad,150,W-pad*2,58,lines); ctx.fillStyle='#6b6760'; ctx.font='24px Arial'; ctx.fillText(s.date||'',pad,230); ctx.fillStyle='#b0a99a'; ctx.font='28px Arial'; var y=290; wrapCanvas(ctx,s.text||'',pad,y,W-pad*2,44,lines); y+=Math.max(1,Math.min(lines.length,7))*44+28;
      function finish(){ ctx.fillStyle='#6b6760';ctx.font='20px Arial';ctx.fillText('xuzhunzhi.github.io',pad,canvas.height-52); var a=document.createElement('a');a.download='straycat-share.png';a.href=canvas.toDataURL('image/png');a.click();showShareTip('详情图片已保存'); }
      if(s.image){ var im=new Image(); im.onload=function(){ var maxW=W-pad*2,maxH=300,scale=Math.min(maxW/im.naturalWidth,maxH/im.naturalHeight,1),iw=im.naturalWidth*scale,ih=im.naturalHeight*scale;ctx.drawImage(im,pad,y,iw,ih);finish(); }; im.onerror=finish; im.src=s.image; } else finish();
    }
    function wrapCanvas(ctx,text,x,y,maxWidth,lineHeight,out){ out.length=0; String(text||'').split(/\r?\n/).forEach(function(row){ var cur=''; for(var i=0;i<row.length;i++){ var next=cur+row[i]; if(ctx.measureText(next).width>maxWidth&&cur){out.push(cur);cur=row[i];}else cur=next;} out.push(cur||' '); }); out.slice(0,7).forEach(function(row,i){ctx.fillText(row,x,y+i*lineHeight);}); }
    window.addEventListener('scroll',function(){ var b=document.getElementById('backTop'); if(b) b.classList.toggle('show',window.scrollY>520); },{passive:true});
    document.addEventListener('keydown',function(e){ if(e.key==='Escape'){ closeLightbox(); var mm=document.getElementById('momentModal'); if(mm&&mm.classList.contains('show')) closeMoment(); var am=document.getElementById('albumModal'); if(am&&am.classList.contains('show')) closeAlbum(); var sm=document.getElementById('shareModal'); if(sm&&sm.classList.contains('show')) closeShare(); var an=document.getElementById('animeModal'); if(an&&an.classList.contains('show')) closeAnime(); } });
