<section class="hero">
  <h1 class="hero-title">Latest <em>Updates</em></h1>
  <p class="hero-sub">流浪猫的避难所 —— 代码、像素与深夜的碎碎念。</p>
</section>

<div class="sec-hd"><span class="sec-num">feed</span><span class="sec-title">All Posts</span><span class="sec-line"></span></div>

<div class="feed-list">
  <% if (page.posts && page.posts.length) { %>
    <% page.posts.each(function(post){ %>
      <% var cat = ''; if (post.categories && post.categories.length) { post.categories.each(function(c){ if(!cat) cat = c.name; }); } %>
      <% var t = cat.indexOf('碎碎念') > -1 ? 'rant' : (cat.indexOf('自设') > -1 ? 'image' : 'article'); %>
      <% var label = t === 'rant' ? '动态' : (t === 'image' ? '自设' : '文章'); %>
      <article class="post-card">
        <span class="post-date"><%= date(post.date, 'YYYY-MM-DD') %></span>
        <span class="feed-type" data-type="<%= t %>"><%= label %></span>
        <h2 class="post-title"><a href="<%= url_for(post.path) %>"><%= post.title %></a></h2>
        <span class="post-arrow">→</span>
      </article>
    <% }) %>
    <nav class="pagination">
      <% if (page.prev) { %><a href="<%= url_for(page.prev_link) %>">← 更早</a><% } %>
      <% if (page.next) { %><a href="<%= url_for(page.next_link) %>">更新 →</a><% } %>
    </nav>
  <% } else { %>
    <p class="empty">还没有文章。</p>
  <% } %>
</div>
